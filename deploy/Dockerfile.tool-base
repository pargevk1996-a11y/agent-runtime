# Base image for MCP tool servers (each tool runs as its own process).
#
#   docker build -f deploy/Dockerfile.tool-base -t agent-runtime-tools .
#   docker run agent-runtime-tools            # default: echo server
#   docker run agent-runtime-tools python -m agent_runtime_tools.code_exec_server
#
# The code_exec server's light isolate needs a production isolate backend when
# AGENT_RUNTIME_ENV=production (see ADR-0010); it refuses to start otherwise.

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder
WORKDIR /app
COPY . .
RUN uv sync --package agent-runtime-tools --no-dev --frozen

FROM python:3.12-slim
WORKDIR /app
COPY --from=builder /app /app
ENV PATH="/app/.venv/bin:$PATH"
RUN useradd --create-home app && chown -R app /app
USER app
CMD ["python", "-m", "agent_runtime_tools.echo_server"]
