# Copy to .env for local development. Never commit a real .env.
# config.py (added in a later increment) loads these with the AGENT_RUNTIME_ prefix.

# --- PostgreSQL -------------------------------------------------------------
# Two roles by design (hard multi-tenant, Row-Level Security):
#   * admin role  — owns schema, runs migrations, may bypass RLS.
#   * app role    — used by API and worker at runtime; RLS applies, cannot bypass.
AGENT_RUNTIME_DB_ADMIN_DSN=postgresql://ar_admin:devpass@localhost:5432/agent_runtime
AGENT_RUNTIME_DB_APP_DSN=postgresql://ar_app:devpass@localhost:5432/agent_runtime

# --- Redis (event fan-out via Streams) --------------------------------------
AGENT_RUNTIME_REDIS_URL=redis://localhost:6379/0

# --- Runtime environment ----------------------------------------------------
# dev | production. The light (subprocess) code isolate refuses to start when
# this is "production" — production must supply a heavy isolate backend.
AGENT_RUNTIME_ENV=dev

# --- OpenTelemetry ----------------------------------------------------------
AGENT_RUNTIME_OTEL_ENDPOINT=http://localhost:4317
